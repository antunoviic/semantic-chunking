# ChromaDB — rebuilt locally
# A pattern rather than single names: chroma_db_ask/ is created by tools/ask.py,
# and every new evaluation run adds another store.
chroma_db_*/
chroma_db/

# Chunk cache — regenerated locally, except the LLM arms of the reported run.
# Those took hours of model time per document and every result of the thesis
# rests on them, so they are tracked; everything else here is rebuilt on demand.
chunks_cache/*
!chunks_cache/nasa_incremental.json
!chunks_cache/nasa_incremental_nofilter.json
!chunks_cache/nasa_incremental_headings_lines.json
!chunks_cache/nasa_incremental_headings_hybrid.json
!chunks_cache/nasa_incremental_enriched.json
!chunks_cache/nasa_incremental_midpoint.json
!chunks_cache/rfc9110_incremental.json
!chunks_cache/rfc9110_incremental_nofilter.json
!chunks_cache/rfc9110_incremental_headings_lines.json
!chunks_cache/rfc9110_incremental_headings_hybrid.json
!chunks_cache/rfc9110_incremental_enriched.json
!chunks_cache/wells_incremental.json
!chunks_cache/wells_incremental_nofilter.json
!chunks_cache/wells_incremental_headings_lines.json
!chunks_cache/wells_incremental_headings_hybrid.json
!chunks_cache/wells_incremental_enriched.json

# Evaluation results (generated locally)
eval_results/
# Exclude the contents, not the directory: only then can single files be added back.
eval_cache/*
# The question sets of the three evaluated documents belong in the repository so
# that the results of the thesis can be reproduced. v4 (nasa, rfc9110) is the
# evaluation reported in the thesis, generated in one round with prompts and
# answers kept in question_prompts/*_literal_v4/. wells has one round.
!eval_cache/nasa_questions_literal_v4.json
!eval_cache/rfc9110_questions_v4.json
!eval_cache/wells_questions.json

# Logs of the chunking and ablation runs (several MB per run)
run_logs/
runs/

# Question-generation prompts: only those behind the three evaluated question
# sets are tracked, in question_prompts/. The rest belong to documents that
# were dropped, or to superseded v2 sets.
question_prompts/dailysteps_literal/
expansion_prompts/
natural_prompts/

# Python
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
dist/
build/

# Experimental modules, not part of the pipeline. Anchored to the root: the
# thesis experiments live in eval/experiments/ and must not be caught by this.
/experiments/
tests/

# macOS
.DS_Store

# Tool state and working instructions to language models
.pytest_cache/
.claude/
PROJECT_CONTEXT.md
IMPLEMENTATION_PROMPT.md
critique_prompts/

# Maintainer tool that writes README-pypi.md before a release; kept locally.
tools/make_pypi_readme.py

# Thesis: the LaTeX source under thesis/latex/, the compiled PDF and the slides
# of the defence are tracked; the experiment scripts live in eval/experiments/.
# What stays out: thesis/overleaf/ is the working copy synchronised with Overleaf
# (its own git repository), and thesis/results/ holds working documents in German
# that feed the chapters — notes towards the thesis, not part of the package.
thesis/results/
thesis/overleaf/
thesis/overleaf_BACKUP_*/
thesis/*.zip
thesis/*_RECOVERED_*.tex

# LaTeX build artefacts
thesis/latex/*.aux
thesis/latex/*.bbl
thesis/latex/*.bcf
thesis/latex/*.blg
thesis/latex/*.fdb_latexmk
thesis/latex/*.fls
thesis/latex/*.lof
thesis/latex/*.log
thesis/latex/*.lot
thesis/latex/*.out
thesis/latex/*.run.xml
thesis/latex/*.synctex.gz
thesis/latex/*.toc
thesis/latex/main.pdf
thesis/latex/chapters/*.aux
