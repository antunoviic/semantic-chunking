# ChromaDB — wird lokal neu gebaut
# Muster statt Einzelnamen: chroma_db_ask/ entsteht durch tools/ask.py,
# weitere Stores kommen bei jedem neuen Auswertungslauf dazu.
chroma_db_*/
chroma_db/

# Chunk-Cache — wird lokal neu generiert
chunks_cache/

# Eval-Ergebnisse (lokal generiert)
eval_results/
eval_cache/

# Logs der Chunking- und Ablationslaeufe (mehrere MB je Lauf)
run_logs/

# Python
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
dist/
build/

# Experimentelle Module, nicht Teil der Pipeline
experiments/

# macOS
.DS_Store
